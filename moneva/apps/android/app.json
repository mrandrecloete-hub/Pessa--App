{
  "expo": {
    "name": "MONEVA",
    "slug": "moneva",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moneva",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.moneva.app",
      "adaptiveIcon": {
        "backgroundColor": "#031A14",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "CAMERA"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#031A14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "MONEVA uses the camera to photograph receipts, payslips and statements you choose to scan.",
          "photosPermission": "MONEVA reads photos you choose to scan."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#04120F"
  }
}