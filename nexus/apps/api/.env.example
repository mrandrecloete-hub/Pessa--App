# Copy to .env (never commit .env). See docs/DEPLOYMENT.md
DATABASE_URL="postgresql://nexus:CHANGE_ME@localhost:5432/nexus?schema=public"
# At least 32 random characters. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS"
NODE_ENV=development
PORT=4000
# Seed only: creates a National Administrator when both are set
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# AI provider (Phase 4): not used yet
AI_PROVIDER=
AI_API_KEY=
